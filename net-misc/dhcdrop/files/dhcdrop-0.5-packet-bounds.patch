+void packet_handler(u_char *user, const struct pcap_pkthdr *h,
+                    const u_char *packet)
+{
+    struct packet_capture *capture = (struct packet_capture *)user;
+
+    /* Never copy more bytes than libpcap actually captured. */
+    if (h->caplen != h->len || h->caplen > DHCP_MTU_MAX || !h->caplen)
+        return;
+
+    memcpy(capture->buffer, packet, h->caplen);
+    capture->length = (int)h->caplen;
