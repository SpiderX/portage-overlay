@@ -0,0 +1,63 @@
+import os
+import subprocess
+import sys
+import pytest
+
+from gslib.tests import util
+from gslib import command
+from gslib import boto_translation
+from gslib.sig_handling import InitializeSignalHandling
+from gslib.utils.parallelism_framework_util import (
+    CheckMultiprocessingAvailableAndInit,
+)
+from gslib.ui_controller import UIController
+
+util.RUN_INTEGRATION_TESTS = False
+
+def pytest_sessionstart(session):
+    InitializeSignalHandling()
+    command.ui_controller = UIController()
+
+    if CheckMultiprocessingAvailableAndInit().is_available:
+        command.InitializeMultiprocessingVariables()
+        boto_translation.InitializeMultiprocessingVariables()
+    else:
+        command.InitializeThreadingVariables()
+
+def pytest_collection_modifyitems(items):
+    if os.environ.get("GSUTIL_PYTEST_ISOLATED") == "1":
+        return
+
+    for item in items:
+        if not getattr(getattr(item, "obj", None),
+                       "requires_isolation", False):
+            continue
+
+        nodeid = item.nodeid
+
+        def run_isolated(nodeid=nodeid):
+            env = os.environ.copy()
+            env["GSUTIL_PYTEST_ISOLATED"] = "1"
+
+            result = subprocess.run(
+                [
+                    sys.executable,
+                    "-m", "pytest",
+                    "-q",
+                    "-o", "log_cli=true",
+                    "-o", "log_cli_level=INFO",
+                    nodeid,
+                ],
+                env=env,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+
+            if result.returncode:
+                pytest.fail(
+                    f"Isolated test failed:\n{result.stdout}\n{result.stderr}",
+                    pytrace=False,
+                )
+
+        item.obj = run_isolated
