+def _NewYAML(round_trip=False, version=None, preserve_quotes=None):
+  parser = yaml.YAML(typ='rt' if round_trip else 'safe', pure=True)
+  if version is not None:
+    parser.version = tuple(int(part) for part in version.split('.'))
+  if preserve_quotes is not None:
+    parser.preserve_quotes = preserve_quotes
+  parser.default_flow_style = False
+  parser.indent(mapping=2, sequence=2, offset=0)
+  parser.representer.add_representer(
+      collections.OrderedDict, parser.representer.represent_dict)
+  if round_trip:
+    parser.representer.add_representer(
+        type(None),
+        lambda representer, value: representer.represent_scalar(
+            'tag:yaml.org,2002:null', 'null'))
+  return parser
+
+
+def _DumpYAML(data, stream=None, round_trip=False, multiple=False, **kwargs):
+  parser = _NewYAML(round_trip=round_trip, version=VERSION_1_2)
+  options = {
+      'default_flow_style': 'default_flow_style',
+      'explicit_start': 'explicit_start',
+      'explicit_end': 'explicit_end',
+      'allow_unicode': 'allow_unicode',
+      'width': 'width',
+  }
+  for key, attribute in options.items():
+    if key in kwargs:
+      setattr(parser, attribute, kwargs.pop(key))
+  if kwargs:
+    raise TypeError('Unsupported YAML dump options: {}'.format(kwargs))
+
+  output = io.StringIO() if stream is None else stream
+  if multiple:
+    parser.dump_all(data, output)
+  else:
+    parser.dump(data, output)
+  return output.getvalue() if stream is None else None
+
