+    enable_testing()
+    find_package(GTest REQUIRED)
 	add_executable(test-spirv-reflect ${CMAKE_CURRENT_SOURCE_DIR}/tests/test-spirv-reflect.cpp
                                       ${CMAKE_CURRENT_SOURCE_DIR}/spirv_reflect.h
                                       ${CMAKE_CURRENT_SOURCE_DIR}/spirv_reflect.c
@@ -105,26 +103,52 @@
                           CXX_STANDARD 11)
