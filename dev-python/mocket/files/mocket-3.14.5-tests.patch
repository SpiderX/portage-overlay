Fix tests with recent redis-py and AnyIO versions
Explicitly select RESP2 for Redis tests because redis-py 8 defaults
to RESP3, which is not supported by Mocket's Redis response mocks.
Defer importing sure until HTTPretty test execution. Importing sure
during pytest collection modifies global attribute lookup, causing
AnyIO's TypedAttributeSet validation to fail with:
"Attribute 'do' is missing its type annotation".
--- ../tests/test_redis.py	2026-10-10 23:22:00.665699939 +0300
+++ ../tests/test_redis.py	2026-10-10 23:22:16.183092566 +0300
@@ -92,7 +92,7 @@
 class TrueRedisTestCase(TestCase):
     @mocketize
     def setUp(self):
-        self.rclient = redis.StrictRedis()
+        self.rclient = redis.StrictRedis(protocol=2)
         self.rclient.flushdb()
 
     def mocketize_teardown(self):
@@ -155,7 +155,7 @@
 
 class RedisTestCase(TestCase):
     def setUp(self):
-        self.rclient = redis.StrictRedis()
+        self.rclient = redis.StrictRedis(protocol=2)
 
     def mocketize_setup(self):
         Entry.register_response("CLIENT SETINFO LIB-NAME redis-py", OK)
