Remove module-level environment variable and AFE server timing
modifications from tests/unit/conftest.py.
These settings are already applied by the autouse fixture using
pytest's monkeypatch, which restores their original values after
each test.
The module-level assignments persist across the test session and
disable AFE metrics in mockserver integration tests, causing
test_gfe_metrics_exported and test_gfe_missing_header_count_exported
to fail when unit and mockserver tests run together.
--- ../tests/unit/conftest.py	2026-10-20 01:05:23.540143428 +0300
+++ ../tests/unit/conftest.py	2026-10-20 01:07:45.112584532 +0300
@@ -21,12 +21,6 @@
     SpannerMetricsTracerFactory,
 )
 
-# Disable builtin metrics and AFE server timing in unit tests
-os.environ["SPANNER_DISABLE_BUILTIN_METRICS"] = "true"
-os.environ["SPANNER_DISABLE_AFE_SERVER_TIMING"] = "true"
-_helpers.ENABLE_AFE_SERVER_TIMING = False
